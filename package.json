{
  "name": "dsh-video-merger",
  "version": "1.0.3",
  "description": "DeepSeek Harness plugin that merges every folder's videos into one file while keeping the source specs. 按文件夹合并视频，保持分辨率/帧率/编码规格不变。",
  "type": "module",
  "license": "MIT",
  "author": "a-mochis",
  "homepage": "https://github.com/a-mochis/dsh-video-merger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-mochis/dsh-video-merger.git"
  },
  "bugs": {
    "url": "https://github.com/a-mochis/dsh-video-merger/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ffmpeg",
    "video",
    "merge",
    "concat",
    "remux"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-video-merger": "bin/merge-videos.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/engine.js",
    "lib/client.js",
    "bin/merge-videos.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/architecture.svg",
    "docs/how-to-select-folder.svg",
    "docs/how-to-merge.svg",
    "docs/marketplace.md",
    "market/index.json",
    "market/icon.svg"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/engine.js && node --check lib/client.js && node --check bin/merge-videos.mjs",
    "test": "node test/market.mjs && node test/browse.mjs && node test/render.mjs",
    "test:market": "node test/market.mjs",
    "test:merge": "node test/run.mjs",
    "fixtures": "node test/make-fixtures.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
